# /etc/default/par-a3-runtime — installed by scripts/install_runtime.sh
#
# Edit this file then: sudo systemctl restart par-a3-runtime.service
# Reboot is NOT required; systemd reloads EnvironmentFile on each unit start.

# Speed tier — match the tiers in DEMO.md:
#   hil      v_max=0.0   w_max=0.0
#   cautious v_max=0.10  w_max=0.50
#   normal   v_max=0.20  w_max=1.00   (90° turns full, U_TURN clipped to ~150°)
#   demo     v_max=0.40  w_max=1.50   (demo day only)
#
# Default below uses normal-tier linear speed but bumps angular cap to 1.20
# rad/s. This is exactly the U_TURN design value (UTURN_W in
# par_qr_nav/interpreter_core.py), so U_TURN executes a full 180° while
# linear motion stays at the safer normal-tier 0.20 m/s.
PAR_V_MAX=0.20
PAR_W_MAX=1.20

# Set to "true" for desk / on-blocks testing — disables H1 ToF + H2 LIDAR
# halos. NEVER on the floor — the robot will not stop for obstacles.
PAR_DISABLE_PROXIMITY_HALOS=false

# LIDAR safety halo — small-room defaults (≤4 m demo arena).
#   PAR_LIDAR_STOP_M  forward-cone distance at which the SafetyLayer
#                     hard-stops the robot (default 0.18 m).
#   PAR_LIDAR_SLOW_M  forward-cone distance at which the SafetyLayer
#                     starts linearly scaling speed down (default 0.35 m).
# Earlier defaults (stop=0.25, slow=0.50) were inherited from
# open-warehouse tutorials and made the robot unable to move in a 3 m
# demo room. "small-room LIDAR halo".
# For larger rooms / open arenas, raise both: PAR_LIDAR_STOP_M=0.25,
# PAR_LIDAR_SLOW_M=0.50.
PAR_LIDAR_STOP_M=0.18
PAR_LIDAR_SLOW_M=0.35

# ---- Project C trial-campaign axes (post-, Phase 1) ---------------------
# Reactive algorithm dispatch:
# nd_hybrid ND classifier + recovery_controller (post- production)
#   nd_only    ND classifier alone (no recovery FSM — failure-mode trials)
# vfh_plus VFH+ + recovery_controller (.. baseline)
PAR_ALGO=nd_hybrid

# Sensor ablation (the rubric-required 5-pointer):
#   true   perception_fusion fuses LIDAR + OAK depth into the polar histogram
#   false  LIDAR-only — depth ignored. Use to quantify the depth contribution.
PAR_USE_DEPTH=true

# Detection-distance tier (per lecturer's "each group must justify a threshold"):
#   tight    safety_dist=0.20  obstacle_thresh=0.30  lidar_stop=0.12  lidar_slow=0.25
#   default  safety_dist=0.30  obstacle_thresh=0.45  lidar_stop=0.18  lidar_slow=0.35
#   wide     safety_dist=0.40  obstacle_thresh=0.60  lidar_stop=0.25  lidar_slow=0.50
# Override individual thresholds via PAR_SAFETY_DIST_M, PAR_OBSTACLE_THRESHOLD_M.
PAR_DETECTION_TIER=default

# Safety-axis ablation. Both default false. Set tof_off=true ONLY for the
# controlled v_max=0.05 m/s safety-failure trial in the campaign.
PAR_TOF_OFF=false
PAR_LIDAR_HALO_OFF=false

# Chassis half-width for Borenstein-Koren angular obstacle inflation.
# 0.165 m for the ROSbot 3 PRO (~33 cm chassis width). 0 disables inflation.
PAR_CHASSIS_HALF_WIDTH_M=0.165

# Cold-boot auto-arm to Mode A . When true, par_a3_runtime.sh
# spawns a background subshell that waits 45 s for the supervisor's IDLE
# publish to settle, then publishes /par/active_mode = A so the reactive
# pipeline (perception_fusion + vfh_planner + recovery_controller) actually
# starts producing intents on a cold boot. Set to false for trial-harness
# runs where every trial begins from a known IDLE state via scene.sh.
PAR_AUTO_ARM_MODE_A=true

# Cold-boot 360° readiness rotation . When true, the
# supervisor publishes a 21-second slow spin (0.3 rad/s, ~360°) after
# self-validate completes so the operator gets a visible "I am ready"
# signal before reactive nav takes over. Set false for trial-harness use
# (per : the auto-yaw between trials was disruptive to the dataset).
# Combined with PAR_AUTO_ARM_MODE_A: spin happens first (5-26 s after
# boot), then auto-arm flips to Mode A at 45 s after a quiet gap.
PAR_ANNOUNCE_ENABLED=true
