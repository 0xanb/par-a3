<?xml version="1.0"?>
<package format="3">
  <name>par_supervisor</name>
  <version>0.1.0</version>
  <description>2-mode supervisor: cold-boot self-validate, 360 readiness announce, button-driven mode switching, LED indication.</description>
  <maintainer email="student@rmit.edu.au">PAR Group</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>par_msgs</depend>
  <export><build_type>ament_python</build_type></export>
</package>
